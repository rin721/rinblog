---
import { getEntry, render } from "astro:content";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import Markdown from "./misc/Markdown.astro";
import type { AppLocale } from "../utils/locale";

interface Props {
	locale: AppLocale;
}

const { locale } = Astro.props;
const entry = await getEntry("pages", locale === "en" ? "links-en" : "links-zh");
if (!entry) throw new Error(`Friends page content not found for locale ${locale}`);
const { Content } = await render(entry);
---

<MainGridLayout
	title={i18n(I18nKey.friends, locale)}
	description={i18n(I18nKey.friends, locale)}
	locale={locale}
>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2 friends-markdown">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
